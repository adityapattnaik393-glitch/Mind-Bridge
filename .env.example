# MindBridge environment configuration

# Server configuration
PORT=5000
APP_TIME_ZONE=Asia/Kolkata
APP_URL=http://localhost:5000

# Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Email notification configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=MindBridge <alerts@your-verified-domain.com>

# Email Notification Configuration (Nodemailer)
EMAIL_USER=your_project_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Supabase Admin Key for background cron jobs (Bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Fallback Caregiver Email (if testing without database records)
CAREGIVER_EMAIL=caregiver_test_email@gmail.com

# Optional frontend aliases
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# NODE_ENV=production
# LOG_LEVEL=info
# Optional frontend aliases
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# NODE_ENV=production
# LOG_LEVEL=info
